# harness.env: paths and caps for the harness tools. Copy to harness.env, edit, and `source` it in
# every shell that runs a tool. Nothing here names a machine; everything is relative to HARNESS_ROOT.

export HARNESS_ROOT=/path/to/your/project          # the directory holding CLAUDE.md, GOAL.md, LEDGER.md
export RECORD_DIR=$HARNESS_ROOT/record             # texts and definitions of record (append-only, new names only)
export WORK_DIR=$HARNESS_ROOT/work                 # per-item working files: texts, errata, memos, onboardings
export LIT_DIR=$HARNESS_ROOT/lit                   # clean literature transcriptions, attachable by line range
export LEAD_DIR=$HARNESS_ROOT/lead                 # the lead's inbox, briefs, ledgers, AGENT_IDS.md
export SCRATCH_DIR=$HARNESS_ROOT/scratch           # bulk outputs; never in the record tree (RESOURCES.md SCRATCH_DIR)
export LANES_DIR=$SCRATCH_DIR/lanes                # API lane run dirs: <tag>_<mmdd>_<HHMM>/ (never list it unfiltered)
export POSTS_DIR=$LEAD_DIR/posts                   # status post drafts (status_post.py)
export BACKUP_ROOT=/path/to/backups                # backup_versioned.sh target, OUTSIDE HARNESS_ROOT
export BACKUP_SOURCES="$RECORD_DIR:record $WORK_DIR:work $LEAD_DIR:lead"

export NUMERICS_PYTHON=python3                     # RESOURCES.md NUMERICS_PYTHON; run as: ulimit -v $MEMORY_CAP_KB; $NUMERICS_PYTHON -I -B ...
export MEMORY_CAP_KB=2500000                       # RESOURCES.md MEMORY_CAP_KB
export TIMEZONES="UTC"                             # RESOURCES.md TIMEZONES, e.g. "UTC America/New_York"
export POST_CAP_CHARS=0                            # RESOURCES.md POST_CAP_CHARS; 1800 for Discord; 0 = none

# API lanes (only with RESOURCES.md API_KEYS = yes)
export LANES_MODEL=claude-opus-5-5                 # RESOURCES.md STRONGEST_MODEL; the per-lane spec may override
export LANES_EFFORT=max                            # RESOURCES.md EFFORT
export LANES_MAX_TOKENS=64000                      # RESOURCES.md OUTPUT_CAP (streaming, so a large cap is safe)
export LANES_ATTACHMENT_CAP=55000                  # RESOURCES.md ATTACHMENT_CAP in bytes
export LANES_PROMPT_CAP=400000                     # hard ceiling per prompt in bytes; the owners' target is lower
export LANES_FORBIDDEN=""                          # comma-separated path fragments from RESOURCES.md FORBIDDEN_SOURCES

# Credentials: the lane runner reads ANTHROPIC_API_KEY from the environment, or from the file below
# (mode 600, one line ANTHROPIC_API_KEY=...). It is never printed, never written to a run dir, never
# put in a prompt or a post. Do NOT put the key in this file if this file is ever shared.
# export ANTHROPIC_SECRETS_FILE=$HOME/.config/harness/secrets.env
